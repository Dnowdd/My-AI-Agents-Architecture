# claude-setup configuration. install.sh copies this to .env on the first run.
# .env is git-ignored. Re-running ./install.sh applies only what changed.

# ── Preferences ────────────────────────────────────────────────
# Language for Claude's replies, subagents and vault notes
RESPONSE_LANGUAGE="English"
# Language for UI copy (labels, messages) in the apps you build
UI_LANGUAGE="en-US"
# Language for code, commits and identifiers
CODE_LANGUAGE="English"
# Default model for the main session (opus | sonnet | haiku | fable | full id). Empty = leave as is.
DEFAULT_MODEL=""
# Obsidian vault folder. Empty = "C:\Claude Brain" on WSL, "~/Claude Brain" elsewhere.
CLAUDE_BRAIN_DIR=""
# Projects folder inside the vault (change it if you renamed or translated the vault folders)
VAULT_PROJECTS_DIR="Projects"
# Database command guard (db-guard hook): on | off
DB_GUARD="on"

# ── Keys ───────────────────────────────────────────────────────
# TypeSafe Jev — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=""
# Jev model
JEV_MODEL="jev-latest"
# GitHub MCP — fine-grained PAT: https://github.com/settings/personal-access-tokens
GITHUB_PAT=""
