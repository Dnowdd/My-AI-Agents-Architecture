# My AI Agents Architecture configuration. install.sh copies this to .env on the first run.
# .env is git-ignored. Re-running ./install.sh applies only what changed.

# ── Tools ──────────────────────────────────────────────────────
# Which tools to set up, space-separated: claude, codex
TARGETS="claude codex"

# ── Preferences ────────────────────────────────────────────────
# Language for the agents' replies, subagents and vault notes
RESPONSE_LANGUAGE="English"
# Language for UI copy (labels, messages) in the apps you build
UI_LANGUAGE="en-US"
# Language for code, commits and identifiers
CODE_LANGUAGE="English"

# ── Models ─────────────────────────────────────────────────────
# Main session model. Empty = leave your current setting alone.
CLAUDE_MODEL=""
CODEX_MODEL=""
# Subagent model per tier. Empty = the subagent inherits the session model.
#   deep:     architect, db-guardian, reviewer, debugger
#   balanced: frontend, backend, verifier, researcher
#   fast:     scribe
CLAUDE_MODEL_DEEP="opus"
CLAUDE_MODEL_BALANCED="sonnet"
CLAUDE_MODEL_FAST="haiku"
CODEX_MODEL_DEEP="gpt-6-astra"
CODEX_MODEL_BALANCED="gpt-6.1-sol"
CODEX_MODEL_FAST="gpt-6-luna"

# ── Long-term memory ───────────────────────────────────────────
# Obsidian vault folder. Empty = "C:\Claude Brain" on WSL, "~/Claude Brain" elsewhere.
CLAUDE_BRAIN_DIR=""
# Projects folder inside the vault (change it if you renamed or translated the vault folders)
VAULT_PROJECTS_DIR="Projects"

# ── Safety ─────────────────────────────────────────────────────
# Database command guard (db-guard hook): on | off
DB_GUARD="on"

# ── Keys ───────────────────────────────────────────────────────
# TypeSafe Jev — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=""
# Jev model
JEV_MODEL="jev-latest"
# GitHub MCP — fine-grained PAT: https://github.com/settings/personal-access-tokens
GITHUB_PAT=""
